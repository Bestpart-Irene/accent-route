# Data and artifacts. Audio is never redistributed from this repo
# (L2-ARCTIC and YouTube licensing).
data/
runs/
# ...but keep the small result summaries: they are what the README cites, and a claim
# whose numbers are not in the repo is not reproducible.
!runs/*/results.json
!runs/*/metrics.json
*.wav
*.mp3
*.ckpt
*.pt

# Credentials. This repo is public, so MDC API keys, HF tokens and the like
# must never be committed.
.env
.env.*
*.key
secrets/
credentials.json

# python
.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.ruff_cache/
.python-version.local

# os
.DS_Store
